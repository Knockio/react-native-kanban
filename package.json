{
  "name": "@knockio/react-native-kanban",
  "version": "0.1.0",
  "description": "Independent React Native Kanban board with drag-and-drop, grouped columns, and infinite load.",
  "license": "MIT",
  "author": "Knockio",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "react-native",
    "kanban",
    "board",
    "drag-and-drop",
    "trello"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Knockio/react-native-kanban.git"
  },
  "bugs": {
    "url": "https://github.com/Knockio/react-native-kanban/issues"
  },
  "homepage": "https://github.com/Knockio/react-native-kanban#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-gesture-handler": ">=2.16",
    "react-native-reanimated": ">=3",
    "react-native-vector-icons": ">=10"
  },
  "peerDependenciesMeta": {
    "react-native-vector-icons": {
      "optional": true
    }
  }
}
